# Tweed for Ghostty, part of cosmic-tweed-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = Tweed
# or, with the Tweed Day half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Tweed,light:TweedDay

background = #292B31
foreground = #D6D1C9

cursor-color = #BDA07F
cursor-text = #292B31

selection-background = #40434C
selection-foreground = #D6D1C9

split-divider-color = #6B6B6E
unfocused-split-fill = #292B31

