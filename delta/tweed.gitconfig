# Tweed for delta (the git diff pager), part of cosmic-tweed-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat Tweed theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/tweed.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = tweed

[delta "tweed"]
    dark = true
    syntax-theme = Tweed
    navigate = true
    line-numbers = true

    file-style = bold "#BDA07F"
    file-decoration-style = "#6B6B6E" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#6B6B6E" box
    hunk-header-file-style = "#A8B49D"
    hunk-header-line-number-style = "#F3E9BD"

    minus-style = "#E77D6C" "#30323A"
    minus-emph-style = bold "#292B31" "#E77D6C"
    minus-non-emph-style = "#E77D6C" "#30323A"
    plus-style = "#919E85" "#30323A"
    plus-emph-style = bold "#292B31" "#919E85"
    plus-non-emph-style = "#919E85" "#30323A"
    zero-style = syntax
    whitespace-error-style = "#292B31" "#F28B7C"

    line-numbers-left-style = "#6B6B6E"
    line-numbers-right-style = "#6B6B6E"
    line-numbers-minus-style = "#E77D6C"
    line-numbers-plus-style = "#919E85"
    line-numbers-zero-style = "#6B6B6E"

    commit-style = bold "#F3E9BD"
    commit-decoration-style = "#6B6B6E" box
    blame-palette = "#292B31 #30323A #363840"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#919E85"
    merge-conflict-theirs-diff-header-style = bold "#F28B7C"
